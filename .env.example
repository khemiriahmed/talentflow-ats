# Copie ce fichier en .env et adapte les valeurs
SPRING_PROFILE=dev
DB_PASSWORD=ats_dev
JWT_SECRET=change-me-with-a-long-random-string-at-least-32-chars
# Emails (en local : MailHog sur http://localhost:8025)
MAIL_FROM=no-reply@talentflow.local
APP_BASE_URL=http://localhost:4200
APP_TIMEZONE=Europe/Paris
# Comptes : passer à true en production pour exiger une adresse email vérifiée
REQUIRE_EMAIL_VERIFICATION=false
AUTH_RATE_LIMIT_PER_MINUTE=100
